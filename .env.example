# ---------------------------------------------------------------------------
# Mal for Snoat sitt lokale miljø.
#
# Ikke kopier denne filen manuelt – kjør `node scripts/bootstrap-env.mjs`.
# Scriptet genererer unike hemmeligheter og signerer ANON_KEY/SERVICE_ROLE_KEY
# med det genererte JWT_SECRET. Kopierte demo-nøkler ville gitt alle
# installasjoner de samme hemmelighetene.
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=snoat

# Absolutt sti, må være identisk på host og i backend-containeren.
SNOAT_WORKSPACE_DIR=/absolutt/sti/til/snoat/.snoat/workspaces

# Host-stien til Docker-socketen. Docker Desktop på macOS bruker ofte
# ~/.docker/run/docker.sock i stedet for standardstien.
DOCKER_SOCKET_PATH=/var/run/docker.sock

SNOAT_ROOT_DOMAIN=snoat.localhost
SNOAT_APP_DOMAIN_SUFFIX=.snoat.localhost

# IP-en kundene peker sitt eget domene mot med en A-record. Vises i DNS-fanen i
# prosjektvisningen, og må være den offentlige IP-en Caddy lytter på.
SNOAT_SERVER_IP=127.0.0.1

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_PASSWORD=

JWT_SECRET=
JWT_EXPIRY=3600
ANON_KEY=
SERVICE_ROLE_KEY=

SITE_URL=http://snoat.localhost
ADDITIONAL_REDIRECT_URLS=http://localhost:3000,http://snoat.localhost
API_EXTERNAL_URL=http://supabase.snoat.localhost
SUPABASE_PUBLIC_URL=http://supabase.snoat.localhost

DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
# Må stå false i produksjon – se CONTEXT_FOR_AI/08_security_model.md.
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false

# --- Resend (SMTP) ----------------------------------------------------------
# Brukernavn er alltid "resend"; passordet er API-nøkkelen.
# Avsenderdomenet må verifiseres på https://resend.com/domains.
RESEND_API_KEY=
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_ADMIN_EMAIL=noreply@snoat.com

# Interne varsler til drift: e-post når en ny app blir live på plattformen.
# Samme Resend-nøkkel som over, men HTTP-API-et i stedet for SMTP. Er
# SNOAT_NOTIFY_TO tom, sendes ingenting – varselet blir en linje i loggen i
# stedet. Flere mottakere skilles med komma.
SNOAT_NOTIFY_FROM=Snoat <varsel@snoat.com>
SNOAT_NOTIFY_TO=
SMTP_SENDER_NAME=Snoat

# GitHub OAuth – https://github.com/settings/developers
# Authorization callback URL: http://supabase.snoat.localhost/auth/v1/callback
GITHUB_OAUTH_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

REALTIME_ENC_KEY=
REALTIME_SECRET_KEY_BASE=

BACKEND_PORT=3100
CADDY_ADMIN_URL=http://caddy:2019
SNOAT_APPS_NETWORK=snoat_apps
SNOAT_FRONTEND_ORIGIN=http://localhost:8080
LOG_LEVEL=info

# Ressurstak per deployet applikasjon. SNOAT_APP_PORT injiseres som PORT i
# containeren – applikasjonen må lytte på den for at Caddy skal nå den.
SNOAT_APP_PORT=3000

# Hvor lenge en ny container må ha kjørt SAMMENHENGENDE før trafikken flyttes til
# den. Sjekken hadde tidligere et fast vindu på 3 s, og slapp gjennom en app som
# krasjet under oppstart: på 0,5 CPU rakk «npm run start» ikke å komme gjennom
# oppstarten før vinduet lukket, så Snoat så en oppstart underveis og kalte den
# stabil. Lavere verdi = raskere deploy, større sjanse for å godkjenne en app som
# ikke kommer opp.
SNOAT_STABLE_FOR_MS=15000

# Taket på ventingen over. Nås det, feiler deploymenten framfor å henge — en app
# som starter, krasjer og starter igjen blir aldri stabil.
SNOAT_STABLE_TIMEOUT_MS=90000
SNOAT_APP_MEMORY_MB=512
SNOAT_APP_CPUS=1
SNOAT_BUILD_TIMEOUT_MS=1800000

# Hvor mange prosjekter som kan bygges samtidig på hele verten. En nix-build tar
# det minnet den trenger, og to samtidige på en liten VPS tar ned Postgres og
# Caddy sammen med seg. Hev først når verten har minne å avse.
SNOAT_MAX_CONCURRENT_BUILDS=1

# Heap-tak for Node under bygging (MB). Uten dette er det verten som setter
# grensen. Ca. 75 % av minnet du kan avse til én build.
SNOAT_BUILD_NODE_MEMORY_MB=1536

# Statiske sider serveres av Caddy rett fra disk, uten container. Stien monteres
# i både backend (skriv) og caddy (les), så den må endres begge steder samtidig
# – docker-compose bruker denne variabelen til begge.
SNOAT_SITES_DIR=/srv/sites
# Hvor mange tidligere versjoner av hver statiske side som beholdes på disk.
SNOAT_STATIC_KEEP_VERSIONS=3

# Node-versjonen prosjekter bygges med når repoet ikke oppgir en selv (verken
# engines.node, .nvmrc eller .node-version). Nixpacks sin egen standard er 18,
# som er ute av vedlikehold og ikke bygger moderne Next.js eller Vite.
SNOAT_DEFAULT_NODE_VERSION=22

# --- Stripe: abonnement og betaling ------------------------------------------
# Valgfritt. Uten STRIPE_SECRET_KEY kjører alle kontoer på Free-grensene, og
# dashboardet skjuler kjøpsknappene i stedet for å vise dem døde.
#
# Nøkkelen hentes fra Stripe-dashboardet (Developers → API keys). Bruk sk_test_
# lokalt; sk_live_ hører kun hjemme i produksjons-.env-en på VPS-en.
STRIPE_SECRET_KEY=

# Signaturhemmeligheten for POST /api/webhooks/stripe.
#
# ⚠️ Er den tom, AVVISES alle webhooks med 503. Det er motsatt av
# GITHUB_WEBHOOK_SECRET, og med vilje: en uverifisert GitHub-webhook starter et
# bygg, mens en uverifisert Stripe-webhook kan gi hvem som helst Business-planen.
#
# Lokalt: kjør `stripe listen --forward-to http://api.snoat.localhost/api/webhooks/stripe`
# og bruk whsec_-verdien den skriver ut. I produksjon: den fra endepunktet du
# oppretter i Stripe-dashboardet. De to er ikke like.
STRIPE_WEBHOOK_SECRET=

# Price-ID-ene (price_…) for de betalte planene, opprettet som gjentakende
# produkter i NOK. Merk: price-ID, ikke product-ID.
#
# Sett `snoat_plan=pro` / `snoat_plan=business` som metadata på PRODUKTET i
# Stripe. Da overlever plangjenkjenningen en framtidig prisendring – ved en ny
# pris får produktet en ny price-ID, mens eksisterende abonnenter blir liggende
# på den gamle.
#
# Live-modus i acct_1U1oJ0Kk43sISMuX har disse fra før:
#   STRIPE_PRICE_PRO=price_1U1piiKk43sISMuXkPn25uvF       (199 kr/mnd eks. mva)
#   STRIPE_PRICE_BUSINESS=price_1U1pijKk43sISMuXPVCR6vgt  (799 kr/mnd eks. mva)
# Testmodus har ingen – opprett dem der før du tester lokalt.
#
# ⚠️ EN price-ID per plan, IKKE en per valuta. Prisene er multi-valuta
# (currency_options i Stripe), og checkout sender `currency` på sesjonen.
# EUR må legges på price-ene før euro-markedet virker – se
# CONTEXT_FOR_AI/12_billing_and_plans.md for kommandoene.
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Markedet som brukes når hverken abonnement, visningsspråk eller Accept-Language
# sier noe. `no` = Norge/NOK, `eu` = alt annet/EUR.
#
# Regelen ellers: norsk visning gir kroner, alt annet gir euro. En kunde som
# allerede har betalt beholder valutaen sin uansett – Stripe låser den til
# kunden ved første faktura.
SNOAT_DEFAULT_MARKET=no

# Lar Stripe Tax regne ut norsk mva i kassen.
#
# ⚠️ Prisene over er opprettet med tax_behavior=exclusive, altså EKS. mva –
# samme grunnlag som PLAN_PRICES i backend/src/services/markets.ts. Står denne
# på false, selges Pro til 199 kr uten at de 25 prosentene kreves inn. Den skal
# stå på true i produksjon.
#
# At Stripe Tax er aktivert på kontoen holder ikke alene: uten mva-registrering
# beregner Stripe 0 % uten å feile. Registreringene legges inn manuelt i
# dashbordet (Tax → Registrations) – de kan ikke opprettes via API-et. Norge
# trenger én; salg til EU-FORBRUKERE krever i tillegg VAT OSS
# (ikke-unionsordningen). EU-bedrifter med mva-nummer går på omvendt
# avgiftsplikt og krever ingenting fra oss.
STRIPE_AUTOMATIC_TAX=true

# Hvor mange dager en kunde beholder planen sin etter en feilet betaling.
# Stripe prøver kortet på nytt i omtrent to uker (Smart Retries), og fristen bør
# dekke hele det vinduet.
SNOAT_BILLING_GRACE_DAYS=14

# Skal bakgrunnsjobben faktisk stoppe apper som ligger over gratisgrensen når
# nådefristen er ute? Standard av: med false logger sveipet kun hva det VILLE
# gjort. Slå den på først når dunning-flyten er observert i produksjon.
SNOAT_BILLING_SUSPEND_ENABLED=false

# Kontoer som kjører helt uten plangrenser. Komma-separert liste av bruker-ID-er
# (auth.users.id, samme verdi som projects.user_id) og/eller e-postadresser – en
# oppføring med @ i seg leses som e-post, alt annet som en ID.
#
# ⚠️ TOM BETYR INGEN EIERKONTOER, ALDRI ALLE. Et fritak krever et treff, og et
# treff krever en oppføring. Faller variabelen ut av miljøet, er alle vanlige
# kunder igjen – ikke omvendt.
#
# Fritaket gjelder alt: antall apper, dev-sider, byggeminutter, byggeminne,
# kjøreminne og CPU, samt topp prioritet i byggekøen og fritak fra
# suspensjonssveipet. Se `EIER_LIMITS` i backend/src/services/plans.ts.
#
# ID-formen er den anbefalte: den slås opp uten et nettverkskall, mens
# e-postformen må hente brukeren fra Supabase Auth i deploy-stien.
#
# Lista leses ved oppstart, så en endring krever ingen ny deploy – men den
# krever at containeren blir REOPPRETTET:
#
#     docker compose up -d --no-deps backend
#
# ⚠️ `docker compose restart backend` er IKKE nok, og det er verdt å forstå
# hvorfor: verdien kommer inn via `${SNOAT_OWNER_ACCOUNTS:-}`-interpolering i
# docker-compose.yml, og interpolering skjer når containeren *opprettes*. En
# restart starter den samme containeren med det samme miljøet, og plukker
# derfor aldri opp den nye verdien. Feilen er stille: backend starter fint, og
# lista er fortsatt tom.
#
# ⚠️ `--no-deps` er heller ikke pynt. `backend` har
# `depends_on: db-migrate: condition: service_completed_successfully`, så uten
# flagget rører compose også db-migrate og kjører alle migrasjonene på nytt som
# bieffekt av en env-endring. Entrypointet der kjører hver .sql med
# ON_ERROR_STOP=1.
#
# Verifiser i oppstartsloggen: backend logger `eierkontoer` fra
# `eierlisteAntall()`. Står det {"ider":0,"eposter":0} nådde variabelen aldri
# containeren.
SNOAT_OWNER_ACCOUNTS=

# -----------------------------------------------------------------------------
# Trafikkanalyse
# -----------------------------------------------------------------------------
# Statistikken hentes ut av Caddys access-logg – ikke av et sporingsskript i
# kundens app. Det er derfor ingenting å konfigurere per prosjekt, og ingen
# tredjepartstjeneste involvert.
#
# Caddy strømmer loggen til denne porten over docker-nettet. Den skal ALDRI
# publiseres på verten: alt som når den kan dikte opp trafikk for et hvilket som
# helst prosjekt.
SNOAT_ANALYTICS_INGEST_PORT=3100

# Hvor lenge treff samles i minnet før de skrives som ferdige rollup-rader.
# Høyere verdi = færre skrivinger, men mer som går tapt hvis prosessen dør brått.
SNOAT_ANALYTICS_FLUSH_MS=5000

# Tidssonen døgnskillet følger. «I dag» skal bety norsk døgn for en norsk kunde.
SNOAT_ANALYTICS_TIMEZONE=Europe/Oslo

# Lagringsbegrensning (GDPR art. 5 nr. 1 bokstav e).
#
# Besøkende-hashene har kortest levetid fordi de er det eneste som er
# per-person, selv om de er anonymisert (sha256 med dagsroterende salt som kun
# finnes i minnet). Aggregatene er ren statistikk uten personkobling; 400 dager
# gir sammenligning mot samme periode i fjor.
SNOAT_ANALYTICS_VISITOR_RETENTION_DAYS=90
SNOAT_ANALYTICS_ROLLUP_RETENTION_DAYS=400

# Valgfri MMDB-database for landstatistikk. Uten den fungerer alt som før, men
# «Land»-fanen skjules. Hentes med:  node scripts/fetch-geoip.mjs
# (DB-IP Lite, CC-BY 4.0 – ingen konto eller lisensnøkkel nødvendig.)
SNOAT_GEOIP_DB_PATH=
