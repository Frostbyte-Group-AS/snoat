{
  "admin": {
    "listen": "0.0.0.0:2019",
    "config": {
      "persist": false
    },
    "origins": ["caddy:2019", "localhost:2019", "127.0.0.1:2019", "[::1]:2019"]
  },
  "logging": {
    "logs": {
      "default": {
        "level": "INFO",
        "exclude": ["http.log.access.snoat_access"]
      },
      "snoat_access": {
        "include": ["http.log.access.snoat_access"],
        "writer": {
          "output": "net",
          "address": "backend:3100",
          "soft_start": true
        },
        "encoder": {
          "format": "filter",
          "wrap": { "format": "json" },
          "fields": {
            "request>headers>Cookie": { "filter": "delete" },
            "request>headers>Authorization": { "filter": "delete" },
            "request>headers>Set-Cookie": { "filter": "delete" },
            "request>headers>Proxy-Authorization": { "filter": "delete" }
          }
        }
      }
    }
  },
  "apps": {
    "tls": {
      "automation": {
        "policies": [
          {
            "subjects": [
              "snoat.com",
              "www.snoat.com",
              "api.snoat.com",
              "supabase.snoat.com",
              "studio.snoat.com",
              "snoat.localhost",
              "api.snoat.localhost",
              "supabase.snoat.localhost",
              "studio.snoat.localhost"
            ]
          },
          { "on_demand": true }
        ],
        "on_demand": {
          "permission": {
            "module": "http",
            "endpoint": "http://backend:3000/internal/tls-ask"
          }
        }
      }
    },
    "http": {
      "servers": {
        "snoat": {
          "listen": [":80", ":443"],
          "logs": {
            "default_logger_name": "snoat_access"
          },
          "routes": [
            {
              "@id": "snoat_https_redirect",
              "match": [
                {
                  "protocol": "http",
                  "not": [{ "path": ["/.well-known/acme-challenge/*"] }]
                }
              ],
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 308,
                  "headers": { "Location": ["https://{http.request.host}{http.request.uri}"] }
                }
              ],
              "terminal": true
            },
            {
              "@id": "snoat_platform_frontend",
              "match": [{ "host": ["snoat.com", "www.snoat.com", "snoat.localhost"] }],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [{ "dial": "frontend:3000" }]
                }
              ],
              "terminal": true
            },
            {
              "@id": "snoat_platform_api",
              "match": [{ "host": ["api.snoat.com", "api.snoat.localhost", "supabase.snoat.com", "supabase.snoat.localhost"] }],
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "match": [
                        {
                          "path": [
                            "/auth/v1/*",
                            "/rest/v1/*",
                            "/realtime/v1/*",
                            "/storage/v1/*",
                            "/graphql/v1/*",
                            "/pg/v1/*"
                          ]
                        }
                      ],
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "upstreams": [{ "dial": "kong:8000" }]
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "upstreams": [{ "dial": "backend:3000" }]
                        }
                      ]
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "@id": "snoat_platform_studio",
              "match": [{ "host": ["studio.snoat.com", "studio.snoat.localhost"] }],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [{ "dial": "studio:3000" }]
                }
              ],
              "terminal": true
            },
            {
              "@id": "snoat_error_endpoint",
              "match": [{ "path": ["/__snoat/*"] }],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [{ "dial": "backend:3000" }]
                }
              ],
              "terminal": true
            },
            {
              "@id": "snoat_apps",
              "handle": [
                {
                  "handler": "subroute",
                  "routes": []
                }
              ]
            },
            {
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 404,
                  "headers": { "Content-Type": ["text/plain; charset=utf-8"] },
                  "body": "snoat – ingen applikasjon er rutet til dette domenet.\n"
                }
              ]
            }
          ]
        }
      }
    }
  }
}
